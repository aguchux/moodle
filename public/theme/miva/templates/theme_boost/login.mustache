{{!
    @template theme_boost/login

    Overrides the Boost login wrapper template to provide a branded two-column layout.
}}
{{> theme_boost/head }}

<body {{{ bodyattributes }}}>
{{> core/local/toast/wrapper}}

<div id="page-wrapper">
    {{{ output.standard_top_of_body_html }}}

    <div id="page" class="container-fluid pt-0 mt-0">
        <div id="page-content" class="row">
            <div id="region-main-box" class="col-12">
                <div id="region-main" class="col-12 h-100">
                    <div class="miva-login">
                        <section class="miva-login__panel">
                            <div class="miva-login__titlebar">{{#str}}loginpagetitle, theme_miva{{/str}}</div>

                            <div class="miva-login__brand">
                                <img src="{{#pix}}miva-logo, theme_miva{{/pix}}" alt="{{sitename}}">
                            </div>

                            <div class="miva-login__heading">
                                <h2>{{#str}}logintitle, theme_miva{{/str}}</h2>
                                <p>{{#str}}loginsubtitle, theme_miva{{/str}}</p>
                            </div>

                            {{{ output.main_content }}}
                        </section>

                        <aside class="miva-login__hero" style="background-image: url('{{#pix}}loginhero, theme_miva{{/pix}}');">
                            <div class="miva-login__herocontent">
                                <h1>
                                    {{#str}}herotitleline1, theme_miva{{/str}}<br>
                                    {{#str}}herotitleline2, theme_miva{{/str}}
                                </h1>
                                <p>{{#str}}herosubtitle, theme_miva{{/str}}</p>

                                <div class="miva-login__badge">
                                    <img src="{{#pix}}nuc-badge, theme_miva{{/pix}}" alt="">
                                    <span>{{#str}}herobadge, theme_miva{{/str}}</span>
                                </div>
                            </div>
                        </aside>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {{> theme_boost/footer }}
</div>

</body>
</html>
{{#js}}
M.util.js_pending('theme_boost/loader');
require(['theme_boost/loader'], function() {
  M.util.js_complete('theme_boost/loader');
});
{{/js}}

